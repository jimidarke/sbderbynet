# DerbyNet Cloud Deployment Environment Configuration
# Copy this file to .env and configure for your deployment
#
# cp .env.example .env
# nano .env

# =============================================================================
# REQUIRED - nginx-proxy Integration
# =============================================================================

# Your domain name (must point to this server)
DOMAIN=derbynet.d-t.pw

# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=admin@example.com

# =============================================================================
# OPTIONAL - Application Settings
# =============================================================================

# Timezone (default: America/New_York)
TZ=America/New_York

# Number of racing lanes (default: 3)
LANE_COUNT=3

# Maximum file upload size (default: 16M)
MAX_UPLOAD_SIZE=16M

# Enable debug logging (default: false)
DERBY_DEBUG=false

# =============================================================================
# INTERNAL - Docker Networking (usually don't change)
# =============================================================================

# MQTT broker hostname (Docker service name)
# MQTT_BROKER=mqtt

# DerbyNet API hostname (Docker service name)
# DERBYNET_API_HOST=derbynet-web
