# DerbyNet Cloud Deployment Environment Configuration
# Copy this file to .env and configure for your deployment
#
# cp .env.example .env
# nano .env

# =============================================================================
# MQTT Authentication
# =============================================================================

# Credentials for MQTT broker access (used by services and gateway bridge)
# Run: ./scripts/setup-mqtt-auth.sh <user> <pass> to generate the passwd file
MQTT_USER=derbynet
MQTT_PASS=changeme

# =============================================================================
# Application Settings
# =============================================================================

# Timezone (default: America/New_York)
TZ=America/New_York

# Number of racing lanes (default: 3)
LANE_COUNT=3

# Maximum file upload size (default: 16M)
MAX_UPLOAD_SIZE=16M

# Enable debug logging (default: false)
DERBY_DEBUG=false

# Cloud display mode: set to "public" when serving Pi-synced kiosk displays
# Forces first-name-last-initial for privacy. Leave empty for dev/test mode.
# DERBYNET_CLOUD_MODE=public

# =============================================================================
# Browser Virtual Hardware (cloud-only)
# =============================================================================

# Credentials served to the browser virtual-hardware pages under
# website/virtual/* via the action.virtual-mqtt-creds endpoint. Mosquitto's
# ACL restricts this user to derbynet/device/B_* publishes.
# Run setup-mqtt-auth.sh; if VIRTUAL_MQTT_PASS is unset it generates one.
VIRTUAL_MQTT_USER=virtual-device
VIRTUAL_MQTT_PASS=
