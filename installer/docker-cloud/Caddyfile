# DerbyNet Cloud Reverse Proxy Configuration
#
# Domain mode: Caddy auto-acquires a Let's Encrypt cert for the host below
# and serves HTTPS on 443 (with HTTP→HTTPS redirect on 80). Requires both
# 80 and 443 to be reachable from the public internet.
#
# Primary public host is soapboxderbynet.com. The UISP container stack on
# the same VPS is kept isolated (siloed via `derbyvps.sh restore-uisp` when
# needed) — Caddy here serves only DerbyNet content, no UISP routing.
#
# Override the hostname via the CADDY_HOST env var if you ever move this
# stack to a different domain.

{$CADDY_HOST:soapboxderbynet.com} {
	encode gzip

	# Strip internal-only headers from any inbound external request. These
	# headers are how the race-server overrides the per-session tenant
	# binding when calling /action.php container-to-container; allowing a
	# public client to set them would let anyone target any tenant DB.
	# Internal services bypass Caddy by talking to derbynet-web:80 directly.
	request_header -X-DerbyNet-Tenant
	request_header -X-DerbyNet-Internal-Token

	# Longer timeouts for file uploads (racer photos)
	request_body {
		max_size 16MB
	}

	# Health check endpoint
	handle /health {
		respond "OK" 200
	}

	# WebSocket -> MQTT for browser virtual devices (cloud-only).
	# Browser code connects to wss://<host>/mqtt using MQTT.js.
	# Auth is enforced by Mosquitto via the virtual-device user + ACL.
	handle /mqtt {
		reverse_proxy mqtt:9001
	}

	# /derbynet/* — strip the prefix and proxy to nginx.
	# The PHP app's nginx config serves at /, but the website's hard-coded
	# URLs (and external bookmarks) use /derbynet/ as the path. handle_path
	# matches the prefix AND strips it before forwarding.
	handle_path /derbynet/* {
		reverse_proxy derbynet-web:80
	}

	# Bare-host requests land on the public splash page (welcome.php), which
	# explains the project and has a CTA into the tenant picker. Operators
	# with bookmarks under /derbynet/ keep working — they bypass the splash.
	redir / /derbynet/welcome.php permanent

	# Default route: anything else goes to nginx as-is.
	handle {
		reverse_proxy derbynet-web:80
	}

	log {
		output stdout
		format console
	}
}

# Public spectator pages — separate site block so it cannot interfere with the
# main control surface above. Reads prerendered HTML from a bind-mount that
# derbynet-stats-gen writes to. The {$LIVE_STATS_TOKEN} env var is what gates
# access; rotate it per race day via `scripts/derbyvps.sh stats-token rotate`.
# An empty token leaves the matcher unable to match anything → everything 404s,
# which is the safe default before the operator mints a token.
{$LIVE_STATS_HOST:live.soapboxderbynet.com} {
	encode gzip

	# Token-gated path. Caddy strips the /<TOKEN>/ prefix, so the file_server
	# root resolves /schedule.html → /srv/public-stats/current/schedule.html.
	# The "__no_token_set__" default is a sentinel: when LIVE_STATS_TOKEN is
	# unset the matcher uses that string, so unrotated stacks serve 404s
	# instead of accidentally exposing files under //*.
	handle_path /{$LIVE_STATS_TOKEN:__no_token_set__}/* {
		root * /srv/public-stats/current
		header Cache-Control "public, max-age=20, stale-while-revalidate=40"
		header X-Robots-Tag "noindex, nofollow"
		header Referrer-Policy "no-referrer"

		# /me/<pinny>.html lookups: if the specific file isn't there (unknown
		# or non-racing pinny), fall through to the friendly notfound page
		# instead of Caddy's generic 404. stats-gen writes me/notfound.html
		# on every render so it's always present.
		@me_paths path /me/*.html
		handle @me_paths {
			try_files {path} /me/notfound.html
			file_server
		}

		# All other token-gated paths: plain file_server, 404 for misses.
		file_server
	}

	# Everything else (bare host, wrong token, probing) returns a flat 404.
	# No body content that hints the route exists.
	handle {
		respond "Not found" 404
	}

	log {
		output stdout
		format console
	}
}
