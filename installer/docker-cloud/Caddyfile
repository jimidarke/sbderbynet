# DerbyNet Cloud Reverse Proxy Configuration
#
# IP-only mode (current): Caddy serves HTTP on port 80
# Domain mode (future):   Change ":80" to "derbynet.d-t.pw" for auto-HTTPS
#
# Usage:
#   IP-only:  :80 { ... }
#   Domain:   derbynet.d-t.pw { ... }

:80 {
	encode gzip

	# Longer timeouts for file uploads (racer photos)
	request_body {
		max_size 16MB
	}

	# Health check endpoint
	handle /health {
		respond "OK" 200
	}

	# WebSocket -> MQTT for browser virtual devices (cloud-only).
	# Browser code connects to wss://<host>/mqtt using MQTT.js.
	# Auth is enforced by Mosquitto via the virtual-device user + ACL.
	handle /mqtt {
		reverse_proxy mqtt:9001
	}

	# Default route: PHP web app
	handle {
		reverse_proxy derbynet-web:80
	}

	log {
		output stdout
		format console
	}
}
