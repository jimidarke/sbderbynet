# Mosquitto ACL for DerbyNet Cloud
#
# Authentication is required (allow_anonymous false). This file gates which
# topics each user can publish/subscribe.
#
# Users are provisioned by scripts/setup-mqtt-auth.sh.
#
# ----------------------------------------------------------------------------
# derbynet (default service user) - full access for race-server and PHP web
# ----------------------------------------------------------------------------
user derbynet
topic readwrite #

# ----------------------------------------------------------------------------
# virtual-device (browser virtual hardware - cloud only)
#
# Browser pages under website/virtual/* fetch this credential from PHP and
# connect to wss://<host>/mqtt. The ACL prevents a leaked browser cred from
# impersonating real hardware: virtual devices may only publish under the
# enumerated B_* hwid namespace below.
#
# Cloud topic shape: derbynet/t/<tenant_slug>/...  The leading `t/+/` segment
# is the tenant scope (one slug per browser sandbox; see
# website/inc/cloud-tenant.inc and website/virtual/virtual-common.js::topic()).
# `+` matches any single tenant slug at the broker level — the PHP session is
# what gates *which* slug a coordinator may use, since this credential is
# tenant-agnostic on the broker side.
#
# Note on syntax: MQTT '+' must be a complete topic segment, not combined
# with literal characters (MQTT spec § 4.7.1.2). Patterns like 'B_+' are
# illegal and would not authorize 'B_FINISH_1'. We enumerate each hwid
# explicitly. Add new lines here when a new virtual device hwid is defined.
# ----------------------------------------------------------------------------
user virtual-device

# Publish: virtual finish timers (B_FINISH_1..4 — max-4-lane derby setup)
topic write derbynet/t/+/device/B_FINISH_1/state
topic write derbynet/t/+/device/B_FINISH_1/telemetry
topic write derbynet/t/+/device/B_FINISH_1/status
topic write derbynet/t/+/device/B_FINISH_2/state
topic write derbynet/t/+/device/B_FINISH_2/telemetry
topic write derbynet/t/+/device/B_FINISH_2/status
topic write derbynet/t/+/device/B_FINISH_3/state
topic write derbynet/t/+/device/B_FINISH_3/telemetry
topic write derbynet/t/+/device/B_FINISH_3/status
topic write derbynet/t/+/device/B_FINISH_4/state
topic write derbynet/t/+/device/B_FINISH_4/telemetry
topic write derbynet/t/+/device/B_FINISH_4/status

# Publish: virtual LED signs (no state topic — signs are display-only)
topic write derbynet/t/+/device/B_LEDSIGN_starter/telemetry
topic write derbynet/t/+/device/B_LEDSIGN_starter/status
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane1/telemetry
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane1/status
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane2/telemetry
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane2/status
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane3/telemetry
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane3/status
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane4/telemetry
topic write derbynet/t/+/device/B_LEDSIGN_usher-lane4/status

# Publish: virtual displays (B_DISPLAY_1, B_DISPLAY_2)
topic write derbynet/t/+/device/B_DISPLAY_1/telemetry
topic write derbynet/t/+/device/B_DISPLAY_1/status
topic write derbynet/t/+/device/B_DISPLAY_2/telemetry
topic write derbynet/t/+/device/B_DISPLAY_2/status

# Publish: virtual start timer.
topic write derbynet/t/+/device/START/state
topic write derbynet/t/+/device/START/telemetry
topic write derbynet/t/+/device/START/status

# Subscribe: read everything devices need to render correctly. The tenant
# wildcard limits a browser to topics under any tenant slug, but it cannot
# escape the t/+/ scope to read raw legacy topics (kept for Pi).
topic read derbynet/t/+/race/state
topic read derbynet/t/+/lane/+/led
topic read derbynet/t/+/lane/+/pinny
topic read derbynet/t/+/ledsign/+/message
topic read derbynet/t/+/ledsign/broadcast
