# DerbyNet Web Application Dockerfile
# Enhanced for cloud deployment with Python simulation support
#
# Build: docker build -t derbynet-web -f installer/docker-cloud/Dockerfile.web .

FROM alpine:3.19

LABEL maintainer="DerbyNet Team"
LABEL description="DerbyNet web application with PHP/Nginx and Python simulation support"

# Timezone configuration
ARG TZ=America/New_York
ENV TZ=${TZ}
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install base packages, PHP, and Python
RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
    bash \
    curl \
    nginx \
    # PHP packages
    php83 \
    php83-fpm \
    php83-opcache \
    php83-gd \
    php83-curl \
    php83-iconv \
    php83-session \
    php83-pdo \
    php83-pdo_sqlite \
    php83-pdo_odbc \
    php83-pdo_mysql \
    # Python for simulation
    python3 \
    py3-pip

# Verify PHP version
RUN ls /usr/sbin/php-fpm83 || exit 1

# Install Python dependencies for simulation
RUN pip3 install --no-cache-dir --break-system-packages \
    paho-mqtt==1.6.1 \
    requests==2.31.0 \
    psutil==5.9.8

# Create directories
ARG WWW_ROOT=/var/www/html

RUN mkdir -m 777 /var/lib/derbynet && \
    mkdir -m 777 /var/lib/derbynet/imagery && \
    mkdir -m 777 /var/lib/derbynet/slides && \
    mkdir -p /var/run/php && \
    mkdir -p /var/lib/infra/app && \
    mkdir -p /var/log

# Copy website files
COPY website/ $WWW_ROOT

# Copy Docker configuration scripts
COPY installer/docker/alpine-snakeoil.sh /usr/local/bin/
COPY installer/docker/alpine-configure-nginx.sh /usr/local/bin/
COPY installer/docker/set-timeout.sh /usr/local/bin/

# Copy Python simulation scripts
COPY extras/soapbox/infra/server/simulate_racing.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/derbyapi.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/derbynet.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/derbylogger.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/serverlogger.py /var/lib/infra/app/

# How large are the pictures you want to upload?
ARG MAX_UPLOAD_SIZE=16M
ENV MAX_UPLOAD_SIZE=${MAX_UPLOAD_SIZE}

# Configure SSL and Nginx
RUN chmod +x /usr/local/bin/*.sh && \
    bash /usr/local/bin/alpine-snakeoil.sh && \
    bash /usr/local/bin/alpine-configure-nginx.sh

# Clean up default files
RUN rm -rf $WWW_ROOT/local/* $WWW_ROOT/index*.html && \
    ( test -d $WWW_ROOT/local || mkdir -m 777 $WWW_ROOT/local )

# Volume for persistent data
VOLUME /var/lib/derbynet

# Environment variables
ENV DERBYNET_CONFIG_DIR=/var/lib/derbynet
ENV DERBYNET_DATA_DIR=/var/lib/derbynet
ENV MQTT_BROKER=mqtt

EXPOSE 80 443

STOPSIGNAL SIGTERM

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost/derbynet/ || exit 1

CMD ["/bin/bash", "-c", "php-fpm83 && chmod 777 /var/run/php/php-fpm.sock && nginx -g 'daemon off;'"]
