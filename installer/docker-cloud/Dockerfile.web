# DerbyNet Web Application Dockerfile
# Enhanced for cloud deployment with Python simulation support
#
# Build: docker build -t derbynet-web -f installer/docker-cloud/Dockerfile.web .

FROM alpine:3.19

LABEL maintainer="DerbyNet Team"
LABEL description="DerbyNet web application with PHP/Nginx and Python simulation support"

# Timezone configuration
ARG TZ=America/New_York
ENV TZ=${TZ}
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install base packages, PHP, and Python
RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
    bash \
    curl \
    nginx \
    # PHP packages
    php83 \
    php83-fpm \
    php83-opcache \
    php83-gd \
    php83-curl \
    php83-iconv \
    php83-session \
    php83-pdo \
    php83-pdo_sqlite \
    php83-pdo_odbc \
    php83-pdo_mysql \
    # Python for simulation
    python3 \
    py3-pip

# Verify PHP version
RUN ls /usr/sbin/php-fpm83 || exit 1

# Ensure PHP application errors land in a known persistent file rather than
# stderr (which on Alpine PHP-FPM gets multiplexed into nginx's access log).
# Also ensure the log dir exists before php-fpm tries to write to it.
RUN mkdir -p /var/log/php83 && \
    printf '\n; sbderbynet: explicit error_log path so volume mount catches it\nerror_log = /var/log/php83/error.log\nlog_errors = On\ndisplay_errors = Off\n' \
      > /etc/php83/conf.d/99-sbderbynet-logging.ini

# Install Python dependencies for simulation.
# psutil needs gcc + headers to compile on Alpine because pip can't always
# match the musllinux wheel for the bundled pip/Python combination.
# Build deps are ephemeral — installed as a virtual package and removed after.
RUN apk add --no-cache --virtual .build-deps gcc python3-dev musl-dev linux-headers && \
    pip3 install --no-cache-dir --break-system-packages \
        paho-mqtt==1.6.1 \
        requests==2.31.0 \
        psutil==5.9.8 && \
    apk del .build-deps

# Create directories
ARG WWW_ROOT=/var/www/html

RUN mkdir -m 777 /var/lib/derbynet && \
    mkdir -m 777 /var/lib/derbynet/imagery && \
    mkdir -m 777 /var/lib/derbynet/slides && \
    mkdir -p /var/run/php && \
    mkdir -p /var/lib/infra/app && \
    mkdir -p /var/log && \
    # setup.nodata creates per-event "test" dirs under $docroot/Data — legacy
    # DerbyNet behavior. PHP-FPM (nobody) needs to be able to mkdir there.
    # Note: contents written here live in the container's writable layer, NOT
    # a persistent volume. Acceptable for a test twin since the actual SQLite
    # DB lives in /var/lib/derbynet (bind-mounted).
    mkdir -p -m 777 ${WWW_ROOT:-/var/www/html}/Data

# Copy website files
COPY website/ $WWW_ROOT

# Copy Docker configuration scripts
COPY installer/docker/alpine-snakeoil.sh /usr/local/bin/
COPY installer/docker/alpine-configure-nginx.sh /usr/local/bin/
COPY installer/docker/set-timeout.sh /usr/local/bin/

# Copy Python simulation scripts
COPY extras/soapbox/infra/server/simulate_racing.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/derbyapi.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/derbynet.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/derbylogger.py /var/lib/infra/app/
COPY extras/soapbox/infra/server/serverlogger.py /var/lib/infra/app/

# How large are the pictures you want to upload?
ARG MAX_UPLOAD_SIZE=16M
ENV MAX_UPLOAD_SIZE=${MAX_UPLOAD_SIZE}

# Configure SSL and Nginx
RUN chmod +x /usr/local/bin/*.sh && \
    bash /usr/local/bin/alpine-snakeoil.sh && \
    bash /usr/local/bin/alpine-configure-nginx.sh

# Clean up default files
RUN rm -rf $WWW_ROOT/local/* $WWW_ROOT/index*.html && \
    ( test -d $WWW_ROOT/local || mkdir -m 777 $WWW_ROOT/local )

# Volume for persistent data
VOLUME /var/lib/derbynet

# Environment variables
ENV DERBYNET_CONFIG_DIR=/var/lib/derbynet
ENV DERBYNET_DATA_DIR=/var/lib/derbynet
ENV MQTT_BROKER=mqtt

EXPOSE 80 443

STOPSIGNAL SIGTERM

# Health check. Inside the container, nginx serves the website at /.
# (The /derbynet/ public path is handled by Caddy stripping the prefix.)
# A 302 to setup.php on a fresh DB still counts as success — curl -f only
# fails on >=400 status codes.
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -fsS http://localhost/ -o /dev/null || exit 1

CMD ["/bin/bash", "-c", "php-fpm83 && chmod 777 /var/run/php/php-fpm.sock && nginx -g 'daemon off;'"]
