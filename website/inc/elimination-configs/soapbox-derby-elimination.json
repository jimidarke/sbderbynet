    "ages_6_8": {
      "name": "Ages 6-8",
      "class_name_pattern": "^(Ages 6-8|6-8|6 to 8).*$",
      "expected_racers": 73,
      "lanes": 3,
      "rounds": [
        {
          "round_sequence": 1,
          "round_name": "Preliminary", 
          "races_per_racer": 3,
          "advancement_rule": "top_count",
          "advance_count": 27,
          "scoring_method": "total_time",
          "description": "Each racer runs 3 times (once in each lane), top 27 advance based on total time"
        },
        {
          "round_sequence": 2,
          "round_name": "Quarter Finals",
          "races_per_racer": 1, 
          "advancement_rule": "top_count",
          "advance_count": 9,
          "scoring_method": "best_time",
          "description": "Each racer runs once, top 9 advance based on best time"
        },
        {
          "round_sequence": 3,
          "round_name": "Semi-Finals",
          "races_per_racer": 1,
          "advancement_rule": "top_count", 
          "advance_count": 3,
          "scoring_method": "best_time",
          "description": "Each racer runs once, top 3 advance based on best time"
        },
        {
          "round_sequence": 4,
          "round_name": "Finals",
          "races_per_racer": 1,
          "advancement_rule": "placement",
          "advance_count": 0,
          "scoring_method": "placement",
          "description": "Single race determines final standings (1st, 2nd, 3rd place)"
        }
      ]
