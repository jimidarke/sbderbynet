<!DOCTYPE html><?php
 // Amazingly: the DOCTYPE is required in order for $(window).height() to work correctly on Chrome.
require_once('inc/data.inc');
require_once('inc/banner.inc');
require_once('inc/authorize.inc');
require_once('inc/schema_version.inc');
require_once('inc/elimination-standings.inc');

// Get classid parameter from kiosk configuration
$classid = null;
$params = kiosk_parameters();
if (isset($params['classid']) && is_numeric($params['classid'])) {
    $classid = $params['classid'];
}

if (!$classid) {
    echo "<div style='text-align: center; padding: 50px; font-size: 24px; color: #666;'>";
    echo "Please configure this kiosk to select a class for elimination tournament standings.";
    echo "</div>";
    exit;
}

try {
    $standings = new EliminationStandingsOracle($classid);
    $tournament_info = $standings->get_tournament_info();
} catch (Exception $e) {
    echo "Error: " . htmlspecialchars($e->getMessage(), ENT_QUOTES, 'UTF-8');
    exit;
}
?>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
<title>Elimination Tournament Standings</title>
<script type="text/javascript" src="js/jquery.js"></script>
<?php require('inc/kiosk-poller.inc'); ?>
<?php require('inc/stylesheet.inc'); ?>
<link rel="stylesheet" type="text/css" href="css/kiosks.css"/>
<link rel="stylesheet" type="text/css" href="css/elimination-kiosks.css"/>
<style type="text/css">
body { 
    overflow: hidden; 
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
}

.tournament-header {
    background: rgba(255, 255, 255, 0.95);
    padding: 8px 15px;
    margin: 10px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 50px;
}

.tournament-title {
    font-size: 24px;
    font-weight: bold;
    color: #1e3c72;
    margin: 0;
    flex: 1;
    text-align: left;
}

.tournament-subtitle {
    font-size: 24px;
    font-weight: bold;
    color: #666;
    margin: 0;
    flex: 1;
    text-align: center;
}

.tournament-progress {
    font-size: 24px;
    font-weight: bold;
    color: #444;
    margin: 0;
    flex: 1;
    text-align: right;
}

.main_table {
    background: white;
    margin: 10px auto;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    width: 90%;
}

.main_table th {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    color: white;
    padding: 12px 8px;
    font-weight: bold;
    border: none;
}

.main_table td {
    padding: 10px 8px;
    border-bottom: 1px solid #eee;
    vertical-align: middle;
}

/* Ensure header and data column widths match exactly */
.main_table th:nth-child(1), .main_table td:nth-child(1) { width: 10%; } /* Place */
.main_table th:nth-child(2), .main_table td:nth-child(2) { width: 10%; } /* Pinny/Car Number */
.main_table th:nth-child(3), .main_table td:nth-child(3) { width: 30%; } /* Name */
.main_table th:nth-child(4), .main_table td:nth-child(4) { width: 15%; } /* Status */
.main_table th:nth-child(5), .main_table td:nth-child(5) { width: 10%; } /* Heats */
.main_table th:nth-child(6), .main_table td:nth-child(6) { width: 15%; } /* Score */
.main_table th:nth-child(7), .main_table td:nth-child(7) { width: 15%; } /* Best */
.main_table th:nth-child(8), .main_table td:nth-child(8) { width: 15%; } /* Worst */

.main_table tr:nth-child(even) {
    background-color: #f8f9fa;
}

.place {
    font-weight: bold;
    font-size: 18px;
    text-align: center;
}

.name {
    font-weight: bold;
}

.carnumber {
    font-weight: bold;
    text-align: center;
}

.status {
    text-align: center;
}

.status .advancing {
    background: #28a745;
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
}

.status .eliminated {
    background: #dc3545;
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
}

.heats {
    text-align: center;
    font-weight: bold;
}

.score, .best, .worst {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-align: center;
    font-size: 18px;
}

/* Scrolling animation for long lists */
@keyframes scroll-standings {
    0% { transform: translateY(100vh); }
    100% { transform: translateY(-100%); }
}

.standings-container {
    height: calc(100vh - 90px);
    overflow: hidden;
    position: relative;
}

.standings-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: white;
}

.standings-header .main_table {
    margin-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    table-layout: fixed;
}

.scroll-content .main_table {
    margin-top: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    table-layout: fixed;
}

.scroll-content {
    animation: scroll-standings 135s linear infinite;
    animation-play-state: paused;
}

.scroll-content.auto-scroll {
    animation-play-state: running;
}
</style>
<script type="text/javascript">
$(document).ready(function() {
    // Auto-scroll if there are many racers - start immediately
    var rowCount = $('.main_table tbody tr').length;
    if (rowCount > 12) {
        $('.scroll-content').addClass('auto-scroll');
    }
    
    // Auto-refresh every 5 seconds to get updated standings
    setInterval(function() {
        window.location.reload();
    }, 5000);
});
</script>
</head>
<body>
<?php make_banner('Elimination Tournament Standings', /* back_button */ false); ?>

<div class="tournament-header">
    <div class="tournament-title">
        <?php echo htmlspecialchars($tournament_info['class_name'], ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <div class="tournament-subtitle">
        <?php echo htmlspecialchars($tournament_info['round_name'], ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <div class="tournament-progress">
        Round <?php echo $tournament_info['current_round']; ?> of <?php echo $tournament_info['total_rounds']; ?>
        <?php if ($tournament_info['advance_count'] > 0): ?>
            • Top <?php echo $tournament_info['advance_count']; ?> Advance
        <?php endif; ?>
    </div>
</div>

<div class="standings-container">
    <div class="standings-header">
        <table class="main_table">
            <thead>
                <?php $standings->write_standings_headers(); ?>
            </thead>
        </table>
    </div>
    <div class="scroll-content">
        <table class="main_table">
            <tbody>
                <?php $standings->write_standings_rows(); ?>
            </tbody>
        </table>
    </div>
</div>

