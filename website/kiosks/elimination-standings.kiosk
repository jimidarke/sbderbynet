<style type="text/css">
body { 
    overflow: hidden; 
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
}

.tournament-header {
    background: rgba(255, 255, 255, 0.95);
    padding: 15px;
    margin: 10px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    text-align: center;
}

.tournament-title {
    font-size: 28px;
    font-weight: bold;
    color: #1e3c72;
    margin-bottom: 5px;
}

.tournament-subtitle {
    font-size: 18px;
    color: #666;
    margin-bottom: 10px;
}

.tournament-progress {
    font-size: 16px;
    color: #444;
}

.main_table {
    background: white;
    margin: 10px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

.main_table th {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    color: white;
    padding: 12px 8px;
    font-weight: bold;
    border: none;
}

.main_table td {
    padding: 10px 8px;
    border-bottom: 1px solid #eee;
    vertical-align: middle;
}

.main_table tr:nth-child(even) {
    background-color: #f8f9fa;
}

.main_table tr:hover {
    background-color: #e3f2fd;
}

.place {
    font-weight: bold;
    font-size: 18px;
    text-align: center;
    min-width: 60px;
}

.name {
    font-weight: bold;
    max-width: 200px;
}

.carnumber {
    font-weight: bold;
    text-align: center;
    min-width: 60px;
}

.status .advancing {
    background: #28a745;
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
}

.status .eliminated {
    background: #dc3545;
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
}

.score, .best, .worst {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-align: center;
    min-width: 80px;
}

.heats {
    text-align: center;
    font-weight: bold;
}

/* Scrolling animation for long lists */
@keyframes scroll-standings {
    0% { transform: translateY(0); }
    50% { transform: translateY(-50%); }
    100% { transform: translateY(0); }
}

.standings-container {
    height: calc(100vh - 120px);
    overflow: hidden;
}

.scroll-content {
    animation: scroll-standings 30s linear infinite;
    animation-play-state: paused;
}

.scroll-content.auto-scroll {
    animation-play-state: running;
}
</style>
<script type="text/javascript" src="js/standings-kiosk.js"></script>
<script type="text/javascript">
$(document).ready(function() {
    // Auto-scroll if there are many racers
    var rowCount = $('.main_table tbody tr').length;
    if (rowCount > 12) {
        setTimeout(function() {
            $('.scroll-content').addClass('auto-scroll');
        }, 5000); // Wait 5 seconds before starting scroll
    }
});
</script>
</head>
<body>
<?php make_banner('Elimination Tournament Standings', /* back_button */ false); ?>

<div class="tournament-header">
    <div class="tournament-title">
        <?php echo htmlspecialchars($tournament_info['class_name'], ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <div class="tournament-subtitle">
        <?php echo htmlspecialchars($tournament_info['round_name'], ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <div class="tournament-progress">
        Round <?php echo $tournament_info['current_round']; ?> of <?php echo $tournament_info['total_rounds']; ?>
        <?php if ($tournament_info['advance_count'] > 0): ?>
            • Top <?php echo $tournament_info['advance_count']; ?> Advance
        <?php endif; ?>
    </div>
</div>

<div class="standings-container">
    <div class="scroll-content">
        <table class="main_table">
            <?php $standings->write_standings_table(); ?>
        </table>
    </div>
</div>

