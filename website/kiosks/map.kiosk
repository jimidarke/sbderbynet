<?php require('inc/kiosk-poller.inc'); ?>
<?php require('inc/stylesheet.inc'); ?>
<link rel="stylesheet" type="text/css" href="css/kiosks.css"/>
<style>
/* Map fills the full viewport. MUST reset max-width/max-height too: css/kiosks.css
   sets .full_page_center img { max-height:80vh; max-width:100vw } and CSS merges
   per-property, so without these the height is capped to 80vh and the 16:9 map
   gets pillarboxed (white L/R + bottom). contain = scale to fit, no crop. */
.full_page_center     { width: 100vw; height: 100vh; padding: 0; margin: 0; }
.full_page_center img { width: 100vw; height: 100vh; max-width: none; max-height: none;
                        object-fit: contain; display: block; }
</style>
</head>
<body class="kiosk">
<!--<p class="kiosk_title">SoapBox Derby Map</p>-->
<div class="full_page_center">
<img src="image.php/map"/>
</div>
<?php require_once('inc/ajax-failure.inc'); ?>

</body>
</html>
