# SoapboxDerbyNet SaaS API - Environment Variables
# Copy this to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql+asyncpg://postgres:${DB_PASSWORD}@localhost:5432/soapboxderbynet

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-256-bit-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase Authentication
# Create a Firebase project and download the service account JSON
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-adminsdk.json

# Alert Manager (Logging)
ALERT_MANAGER_URL=https://alert.d-t.pw/alert
ALERT_MANAGER_USERNAME=soapboxderbynet
ALERT_MANAGER_PASSWORD=your-alert-manager-password
ALERT_MANAGER_ENABLED=true

# Stripe (Donations)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Rate Limiting
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_DEVICE_PER_MINUTE=1000
RATE_LIMIT_AUTH_PER_MINUTE=20

# CORS (comma-separated list)
CORS_ORIGINS=https://soapboxderbynet.com,https://www.soapboxderbynet.com,http://localhost:3000
