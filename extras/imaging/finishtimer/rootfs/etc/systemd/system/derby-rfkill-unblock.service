# Pi OS soft-blocks the WiFi radio via rfkill until the WiFi country is set
# through raspi-config/firstrun (which we don't run). Setting the kernel
# regdomain (cfg80211.ieee80211_regdom=CA on the cmdline) sets the *country* but
# does NOT clear the rfkill soft-block — confirmed 2026-05-29: wlan0 came up
# "Soft blocked: yes" and never associated until a manual `rfkill unblock wifi`.
# Run it on every boot, before wpa_supplicant grabs the interface.
[Unit]
Description=Unblock the WiFi rfkill soft-block (Pi OS blocks until country configured)
After=systemd-rfkill.service
Before=wpa_supplicant@wlan0.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/rfkill unblock wifi
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
