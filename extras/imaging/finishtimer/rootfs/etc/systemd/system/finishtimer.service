[Unit]
Description=DerbyNet Finish Timer
After=network-online.target derby-pull.service
Wants=network-online.target
# Only start finishtimer once derby-pull has tried to refresh /opt/derbynet.
# derby-pull is a oneshot that no-fails when offline.
PartOf=multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/derbynet
ExecStart=/usr/bin/python3 /opt/derbynet/files/finishtimer.py
Restart=always
RestartSec=10
Environment="MQTT_BROKER=192.168.100.10"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finishtimer
# No WatchdogSec= — systemd's watchdog requires the app to send periodic
# WATCHDOG=1 sd_notify pings, and finishtimer.py doesn't. Same trap derbypi
# hit on 2026-05-21 (see derbyrace.service). Restart=always covers crashes.

[Install]
WantedBy=multi-user.target
