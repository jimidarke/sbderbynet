[Unit]
Description=Derby Display Telemetry
After=network-online.target derby-pull.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/derbynet
ExecStart=/usr/bin/python3 /opt/derbynet/derbydisplay.py
Restart=always
RestartSec=10
Environment="MQTT_BROKER=192.168.100.10"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=derbydisplay

[Install]
WantedBy=multi-user.target
