[Unit]
Description=Derby Display Telemetry
After=network-online.target derby-pull.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/derbynet
# MQTT_BROKER is resolved at boot from /boot/firmware/derby-server.txt by the
# wrapper (see derby-server-host), not hardcoded here.
ExecStart=/usr/local/sbin/derbydisplay-run
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=derbydisplay

[Install]
WantedBy=multi-user.target
