[Unit]
Description=DerbyNet first-boot configuration (single-shot)
After=network-online.target
Wants=network-online.target
# Single-shot is enforced by the script itself (it self-disables the service
# after success). Do NOT add ConditionFirstBoot — it gates on
# /etc/machine-id state and silently skips on every reflash where the
# machine-id was baked into the image, which is exactly our case.
ConditionPathExists=/etc/derby-role

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/derby-firstboot.sh
StandardOutput=journal
StandardError=journal
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
