[Unit]
Description=Derby Race Server
After=network-online.target mosquitto.service nginx.service
Wants=mosquitto.service network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/infra/server
ExecStart=/usr/bin/python3 /var/lib/infra/server/derbyRace.py
Restart=always
RestartSec=10
Environment="DERBY_CONSOLE_LOG=false"
Environment="DERBY_DEBUG=false"
# derbyRace.py defaults MQTT_BROKER to 'localhost', but the baked mosquitto
# config binds to 192.168.100.10:1883 only (defense in depth) — so the
# default fails with ECONNREFUSED. Match the satellite services explicitly.
Environment="MQTT_BROKER=192.168.100.10"
Environment="DERBYNET_API_HOST=127.0.0.1"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=derbyrace

# Watchdog: if derbyRace.py wedges, systemd kills + restarts after 60s.
WatchdogSec=60s

[Install]
WantedBy=multi-user.target
