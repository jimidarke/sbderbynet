# HLS Feed Configuration — TEMPLATE
#
# Copy this file to `config.env` on the streaming host and fill in real
# credentials. The live `config.env` is gitignored (see repo .gitignore).
# RTSP camera passwords MUST NOT be committed.

# Stream settings
# Format: rtsp://<user>:<password>@<camera-ip>:554/<stream-path>
RTSP_URL="rtsp://CAMERA_USER:CAMERA_PASSWORD@192.168.100.20:554/21"
HLS_DIR="/opt/hlsfeed/hls"
HLS_SEGMENT_TIME=2
HLS_LIST_SIZE=5

# Stream quality settings
VIDEO_PRESET="veryfast"
VIDEO_BITRATE="1500k"
GOP_SIZE=25

# Cleanup settings
MAX_SEGMENT_AGE_MINUTES=30
LOG_RETENTION_DAYS=7

# Log settings
LOG_FILE="/var/log/hlsfeed.log"
LOG_LEVEL="INFO"
