    <table:table-row table:style-name="Table1.5">
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:list xml:id="list74820594740099" text:continue-numbering="true" text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P17"><text:span text:style-name="T5">If balloting is open, t</text:span><text:span text:style-name="T4">he voting page </text:span><text:span text:style-name="T5">shows a list of the awards available for voting, and the voter’s current selections, if any. <text:s/>(Visitors who have already voted from the same browser may change their votes </text:span><text:span text:style-name="T8">as long as balloting remains open</text:span><text:span text:style-name="T5">, but </text:span><text:span text:style-name="T8">they</text:span><text:span text:style-name="T5"> are not able to cast new ballots.)</text:span></text:p>
       </text:list-item>
      </text:list>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B2" office:value-type="string">
