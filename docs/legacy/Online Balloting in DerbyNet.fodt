     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="TableLine105553233397760">
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:list xml:id="list74821892002840" text:continue-numbering="true" text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P19">If you wish, you can set a password, to try to limit voting to authorized users. <text:s/>(For online balloting in combination with live streaming, consider announcing or presenting the password in the live stream.)</text:p>
       </text:list-item>
      </text:list>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B2" office:value-type="string">
      <text:p text:style-name="P6"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="TableLine105553233398016">
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:list xml:id="list74821871765684" text:continue-numbering="true" text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P19">No votes can be cast unless or until balloting is open. <text:s/>The control at the top of the dialog lets you choose when voting is allowed.</text:p>
       </text:list-item>
      </text:list>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B2" office:value-type="string">
      <text:p text:style-name="P6"/>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table1.5">
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:list xml:id="list74821690533193" text:continue-numbering="true" text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P19">When at least one award has been selected for balloting, users who are not logged in are offered a “Vote!” choice on the landing page.</text:p>
       </text:list-item>
      </text:list>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B2" office:value-type="string">
