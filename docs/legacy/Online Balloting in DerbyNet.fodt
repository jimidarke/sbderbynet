    <table:table-row table:style-name="Table1.5">
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:list xml:id="list74822853268632" text:continue-numbering="true" text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P18"><text:span text:style-name="T4">Clicking on th</text:span><text:span text:style-name="T5">e “Votes”</text:span><text:span text:style-name="T4"> marker opens a dialog showing the </text:span><text:span text:style-name="T5">vote tabulations</text:span><text:span text:style-name="T4"> </text:span><text:span text:style-name="T5">for</text:span><text:span text:style-name="T4"> the award.</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:p text:style-name="P11"><text:span text:style-name="T4">E</text:span><text:span text:style-name="T5">ach entry in the tabulation has a “Choose” button. <text:s/>Clicking on a “Choose” button will assign that candidate as the winner of the award.</text:span></text:p>
      <text:p text:style-name="P12"><text:span text:style-name="T4">Y</text:span><text:span text:style-name="T2">ou, the judge, retain final authority to choose who wins the award, regardless of the votes cast. <text:s/>(At the least, you’ll want to be able to resolve tie votes.)</text:span></text:p>
      <text:p text:style-name="P12">All awards can still be assigned or unassigned by dragging and dropping, whether or not they’re on the online ballot.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B2" office:value-type="string">
