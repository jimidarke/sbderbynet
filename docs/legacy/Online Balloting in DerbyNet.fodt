    <table:table-row table:style-name="TableLine105553233399040">
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:list xml:id="list74820633114781" text:continue-numbering="true" text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P20">Clicking on a candidate lets the voter see a full-size photo of the car. <text:s/>Clicking in the “Vote” box selects or de-selects the candidate.</text:p>
       </text:list-item>
      </text:list>
     </table:table-cell>
